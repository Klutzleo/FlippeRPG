# Ensure consistent line endings across platforms
* text=auto eol=lf

# Treat C and header files as text
*.c text
*.h text

# Treat build artifacts as binary
*.fap binary
*.elf binary
*.bin binary

# Ignore diffing for binary files
*.fap -diff
*.elf -diff
*.bin -diff

# Mark README and license as UTF-8 text
README.md text eol=lf
LICENSE text eol=lf